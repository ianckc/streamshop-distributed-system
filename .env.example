# Compose variable substitution (copy to .env and adjust as needed)
# docker compose automatically loads .env from this directory

TRAEFIK_HTTP_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081

CATALOG_API_PORT=3001
CATALOG_API_SERVICE_NAME=catalog-api

ORDER_API_PORT=3002
ORDER_API_SERVICE_NAME=order-api

POSTGRES_USER=streamshop
POSTGRES_PASSWORD=streamshop
POSTGRES_DB=streamshop
POSTGRES_PORT=5432

# Used by order-api inside Compose (hostname is the service name "postgres")
DATABASE_URL=postgres://streamshop:streamshop@postgres:5432/streamshop?sslmode=disable
