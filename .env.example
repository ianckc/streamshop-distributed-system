# Compose variable substitution (copy to .env and adjust as needed)
# docker compose automatically loads .env from this directory

TRAEFIK_HTTP_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081

CATALOG_API_PORT=3001
CATALOG_API_2_PORT=3011

ORDER_API_PORT=3002
ORDER_API_SERVICE_NAME=order-api

ANALYTICS_API_PORT=3003
ANALYTICS_API_SERVICE_NAME=analytics-api

EVENT_PROCESSOR_PORT=3004
EVENT_PROCESSOR_SERVICE_NAME=event-processor

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=streamshop
CLICKHOUSE_PASSWORD=streamshop
CLICKHOUSE_DB=streamshop

POSTGRES_USER=streamshop
POSTGRES_PASSWORD=streamshop
POSTGRES_DB=streamshop
POSTGRES_PORT=5432

MONGO_PORT=27017
MONGO_INITDB_DATABASE=streamshop

REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540

REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8082

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=streamshop
MINIO_ROOT_PASSWORD=streamshop

# Observability (docker compose --profile observability up)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
# Grafana UI is :3000. Local docs dev server is :3100/docs/ (`cd docs && npm start`).
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Set by Compose for all services; points to the OTel Collector inside the network
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Used by order-api inside Compose (hostname is the service name "postgres")
DATABASE_URL=postgres://streamshop:streamshop@postgres:5432/streamshop?sslmode=disable

# Used by order-api and event-processor inside Compose (hostname is the service name "redpanda")
KAFKA_BROKERS=redpanda:9092

# Used by event-processor inside Compose (HTTP interface; native 9000 is not published — MinIO uses 9000)
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=streamshop

# Used by catalog-api inside Compose (hostname is the service name "mongo")
MONGODB_URI=mongodb://mongo:27017/streamshop

# Used by catalog-api inside Compose (hostname is the service name "redis")
REDIS_URL=redis://redis:6379

# Used by catalog-api inside Compose (hostname is the service name "minio")
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=product-images
S3_REGION=us-east-1
