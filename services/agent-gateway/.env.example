# Copy to .env and adjust as needed:
#   cp .env.example .env

# LLM (OpenAI-compatible). Examples:
#   Ollama:  LLM_BASE_URL=http://host.docker.internal:11434  LLM_API_KEY=ollama
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai         LLM_API_KEY=gsk_...
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api       LLM_API_KEY=sk-or-...
LLM_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b

# Session store (StreamShop Compose Redis)
REDIS_URL=redis://redis:6379

# Listen port (Traefik owns host :8080; use 3010 inside the stack)
PORT=3010

# StreamShop service bases (Compose DNS). Used by tools in later chunks.
STREAMSHOP_ANALYTICS_URL=http://analytics-api:3003
STREAMSHOP_ORDER_URL=http://order-api:3002
STREAMSHOP_CATALOG_URL=http://catalog-api-1:3001
STREAMSHOP_EVENT_PROCESSOR_URL=http://event-processor:3004

# Optional: tracing filter, e.g. info or agent_gateway=debug,tower_http=info
# RUST_LOG=info
